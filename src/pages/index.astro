---
import Base from "../layouts/Base.astro";
import { SITE, LINKS } from "../consts";
---

<Base>
  <main class="flex min-h-dvh flex-col px-6 pb-10 sm:px-12">
    <div class="flex flex-1 items-center">
      <h1 class="text-balance text-6xl font-bold tracking-tight sm:text-8xl">
        {SITE.headline}
      </h1>
    </div>

    <p class="font-mono text-sm text-muted">{SITE.tagline}</p>

    <div class="mt-8 grid max-w-2xl grid-cols-1 gap-10 sm:grid-cols-2">
      <ul class="flex flex-col gap-2.5 font-mono text-sm uppercase tracking-widest">
        <li>
          <a href="/work" class="underline underline-offset-4 hover:text-muted"
            >view work</a
          >
        </li>
        <li>
          <a href="/blog" class="underline underline-offset-4 hover:text-muted"
            >read blog</a
          >
        </li>
      </ul>
      <div class="font-mono text-sm uppercase tracking-widest">
        <p class="text-muted">now</p>
        <ul class="mt-2.5 flex flex-col gap-2.5">
          <li>
            <a
              href="/work/panda-basket"
              class="underline underline-offset-4 hover:text-muted"
              >panda basket</a
            >
          </li>
        </ul>
      </div>
    </div>

    <ul
      class="mt-16 flex flex-wrap gap-x-6 gap-y-2 font-mono text-sm uppercase tracking-widest"
    >
      {
        LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-muted hover:text-fg"
              {...link.href.startsWith("http")
                ? { target: "_blank", rel: "noopener noreferrer" }
                : {}}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Base>
