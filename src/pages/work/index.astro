---
import Base from "../../layouts/Base.astro";

// 作品以后会多,先用数组管理;每一项指向站内详情页,不外跳。
const projects = [
  {
    title: "Panda Basket",
    href: "/work/panda-basket",
    blurb:
      "An AI fridge app for people who cook for one — talk, snap the receipt or paste a link, and it keeps track of what you have and what to cook.",
    meta: "iOS app · shipped 2026",
  },
];
---

<Base title="work" description="Selected work by Lloyyd.">
  <main class="mx-auto w-full max-w-3xl px-6 pb-48 pt-16">
    <h1 class="text-2xl font-medium tracking-tight">Work</h1>

    <ul class="mt-12 flex flex-col gap-8">
      {
        projects.map((project) => (
          <li>
            <a
              href={project.href}
              class="underline underline-offset-4 hover:text-muted"
            >
              {project.title}
            </a>
            <span class="ml-3 font-mono text-xs uppercase tracking-widest text-muted">
              {project.meta}
            </span>
            <p class="mt-1.5 text-muted">{project.blurb}</p>
          </li>
        ))
      }
    </ul>
  </main>
</Base>
