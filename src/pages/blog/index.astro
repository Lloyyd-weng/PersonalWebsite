---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { comparePosts } from "../../consts";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  comparePosts,
);
---

<Base title="blog" description="Notes and writing by Lloyyd.">
  <main class="mx-auto w-full max-w-3xl px-6 pb-48 pt-16">
    <h1 class="text-2xl font-medium tracking-tight">Blog</h1>
    <div class="mt-12">
      <PostList posts={posts} />
    </div>
  </main>
</Base>
