---
import Base from "../layouts/Base.astro";
---

<Base title="404">
  <main class="max-w-2xl px-12 pb-48 pt-16 sm:px-24">
    <p class="font-mono text-sm text-muted">404</p>
    <h1 class="mt-2 text-2xl font-medium tracking-tight">
      This page doesn't exist.
    </h1>
    <p class="mt-4 text-muted">The link may be old, or the page may have moved.</p>
    <a
      href="/"
      class="mt-8 inline-block font-mono text-sm underline underline-offset-4 hover:text-muted"
      >← back home</a
    >
  </main>
</Base>
